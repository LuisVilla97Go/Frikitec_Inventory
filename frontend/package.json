{
	"name": "frontend",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"test:ci": "ng test --watch=false",
		"test:cobertura": "ng test --watch=false --coverage",
		"e2e": "playwright test",
		"typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
		"lint": "biome check"
	},
	"private": true,
	"engines": {
		"node": "^22.22.3 || ^24.15.0 || >=26.0.0"
	},
	"packageManager": "pnpm@12.4.1",
	"dependencies": {
		"@angular/common": "~22.2.1",
		"@angular/compiler": "~22.2.1",
		"@angular/core": "~22.2.1",
		"@angular/forms": "~22.2.1",
		"@angular/platform-browser": "~22.2.1",
		"@angular/router": "~22.2.1",
		"@fontsource/rubik": "^5.3.0",
		"@fontsource/tomorrow": "^5.3.0",
		"@lucide/angular": "^1.47.0",
		"@tanstack/angular-query-experimental": "^5.103.2",
		"@zxing/browser": "^0.2.1",
		"chart.js": "4.5.1",
		"jsbarcode": "^3.12.3",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0",
		"valibot": "^1.5.0",
		"zone.js": "~0.15.1"
	},
	"devDependencies": {
		"@angular/build": "~22.2.0",
		"@angular/cli": "~22.2.0",
		"@angular/compiler-cli": "~22.2.1",
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@types/jsbarcode": "^3.11.4",
		"@types/node": "^24.13.6",
		"@vitest/coverage-v8": "4.1.11",
		"autoprefixer": "^10.6.1",
		"jsdom": "^30.1.1",
		"lint-staged": "^17.5.1",
		"postcss": "^8.5.28",
		"tailwindcss": "^3.4.15",
		"typescript": "~6.0.3",
		"vitest": "^4.0.8"
	},
	"lint-staged": {
		"*.{js,ts,html,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
